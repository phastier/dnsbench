# dnsbench v2 configuration
# Lines starting with # are comments. Sections in [brackets].

# Number of measurement rounds per mode (HIT and MISS each get this many).
rounds = 200

# Receive timeout. timeout_ms takes precedence over timeout_sec when both are set.
timeout_sec = 1
#timeout_ms = 250

# Pacing: fixed sleep between queries (sequential) or phases (parallel), in ms.
# Useful to stay under resolver-side rate limits: Pi-hole FTL defaults to
# 1000 queries / 60 s / client and answers REFUSED beyond (visible in `err`).
#gap_ms = 5

# Add an EDNS0 OPT record (UDP bufsize 1232), like modern stub resolvers.
#edns = no

# Global query type: A, AAAA, HTTPS, TXT, or a bare numeric type (e.g. 65).
qtype = A

# hit | miss | both
mode = both

# Sequential (closed-loop, default) or parallel (one in-flight query per
# resolver, poll-based fan-out).
parallel = no

# Cache-HIT domains, one per line: name [qtype]
# Rotated round-robin across rounds. The optional per-domain qtype overrides
# the global one. Prefer names with LONG TTLs: the warm-up prints the answer's
# min TTL and warns below 120 s, because a run longer than the TTL re-fetches
# upstream and contaminates HIT with MISS.
[hit_domains]
www.apple.com
www.wikipedia.org
#example.com HTTPS

# Base domain for cache-MISS: queries go to <12-hex-random>.<miss_base>.
# Use a zone you control (or example.com); NXDOMAIN is the expected answer
# and counts as a valid latency sample.
miss_base = example.com

# Resolvers to probe: address name, one per line. v4 and v6 mix freely.
[resolvers]
9.9.9.9         quad9-v4
2620:fe::fe     quad9-v6
1.1.1.2         cloudflare-v4
2606:4700:4700::1112 cloudflare-v6
8.8.8.8         google-v4
2001:4860:4860::8888 google-v6
